rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Full lead list: verified accounts can read, nobody can write from the client.
    match /lead_chunks/{chunkId} {
      allow read: if request.auth != null && request.auth.token.email_verified == true;
      allow write: if false;
    }

    // Each user's profile, statuses and notes: only that user.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
